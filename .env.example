# Optional override for raw ingest output
HIVEFLOW_DATA_DIR=data

# Optional: target a different company/environment from config.yaml
# HIVEFLOW_COMPANY=POC
# HIVEFLOW_ENVIRONMENT=dev

# QBO app credentials and OAuth tokens live in AWS Secrets Manager only.
# Secret names are derived from config.yaml (company + tier), not stored here.

# Optional: write ingest output to S3 instead of local disk (Lambda sets these automatically)
# HIVEFLOW_S3_BUCKET=raw-poc-dev-749794722426-us-east-2
# HIVEFLOW_S3_PREFIX=qbo
