{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshflow.dev/schemas/bc/entity_properties.json",
  "title": "MS Learn entity properties (global / gold)",
  "description": "Catalog of Business Central silver entities and their MS Learn properties. Used for global source docs and client gold merges.",
  "type": "object",
  "required": ["source", "kind", "tables"],
  "additionalProperties": true,
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "kind": { "const": "ms_learn_entity_properties" },
    "description": { "type": "string" },
    "generated_at": { "type": "string" },
    "ms_learn_toc": { "type": "string" },
    "table_count": { "type": "integer", "minimum": 0 },
    "property_count": { "type": "integer", "minimum": 0 },
    "scrape_failures": {
      "type": "array",
      "items": { "type": "object" }
    },
    "sourced_from": { "type": "string" },
    "merged_from": { "type": "object" },
    "tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "silver_column": { "type": "string" },
        "in_silver": { "type": "boolean" },
        "origin": {
          "type": "string",
          "enum": ["api", "unpack", "sql_pack", "key_derivation", "documentation_only"]
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["silver_entity", "properties"],
      "additionalProperties": true,
      "properties": {
        "silver_entity": { "type": "string", "minLength": 1 },
        "bc_resource_slug": { "type": "string" },
        "description": { "type": "string" },
        "ms_learn_url": { "type": "string" },
        "property_count": { "type": "integer", "minimum": 0 },
        "in_silver": { "type": "boolean" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      }
    }
  }
}
