{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshflow.dev/schemas/bc/entity_properties.overlay.json",
  "title": "Client overlay for entity properties",
  "description": "Client-specific exclude/addition overlay for entity_properties.yaml. Lives under governance/source_semantic_reference/{source}/ in the company lake bucket.",
  "type": "object",
  "required": ["source", "kind"],
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "kind": { "const": "ms_learn_entity_properties_overlay" },
    "description": { "type": "string" },
    "generated_at": { "type": "string" },
    "exclude": { "$ref": "#/$defs/exclude" },
    "addition": { "$ref": "#/$defs/addition" }
  },
  "$defs": {
    "property": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["silver_entity", "properties"],
      "additionalProperties": true,
      "properties": {
        "silver_entity": { "type": "string", "minLength": 1 },
        "bc_resource_slug": { "type": "string" },
        "description": { "type": "string" },
        "ms_learn_url": { "type": "string" },
        "property_count": { "type": "integer", "minimum": 0 },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      }
    },
    "exclude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["silver_entity", "names"],
            "additionalProperties": false,
            "properties": {
              "silver_entity": { "type": "string", "minLength": 1 },
              "names": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "addition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity" }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["silver_entity", "properties"],
            "additionalProperties": false,
            "properties": {
              "silver_entity": { "type": "string", "minLength": 1 },
              "properties": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/property" }
              }
            }
          }
        }
      }
    }
  }
}
