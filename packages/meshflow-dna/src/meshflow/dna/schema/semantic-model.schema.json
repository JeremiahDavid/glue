{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshflow.dev/schemas/dna/semantic-model.json",
  "title": "Source Semantic Model",
  "description": "Qualified silver layer — entities, attributes, relationships, and open questions before gold compile.",
  "type": "object",
  "required": ["version", "status", "source", "entities", "attributes", "relationships"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "production"]
    },
    "source": {
      "type": "string",
      "description": "Silver source connector (e.g. dbc, qbo)"
    },
    "updated_at": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "attributes": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribute" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "silver_entity", "role", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "silver_entity": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["fact", "dimension", "bridge", "reference"]
        },
        "grain": {
          "type": "string"
        },
        "primary_key": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "approved", "rejected"]
        },
        "citation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["entity", "column", "status"],
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "role": {
          "type": "string",
          "enum": ["foreign_key", "measure", "identifier", "dimension", "date", "status"]
        },
        "data_type": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "approved", "rejected"]
        },
        "notes": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from_entity",
        "from_column",
        "to_entity",
        "to_column",
        "cardinality",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "from_entity": {
          "type": "string",
          "minLength": 1
        },
        "from_column": {
          "type": "string",
          "minLength": 1
        },
        "to_entity": {
          "type": "string",
          "minLength": 1
        },
        "to_column": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "type": "string",
          "enum": ["many_to_one", "one_to_many", "one_to_one", "many_to_many"]
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "approved", "rejected"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "blocks_publish": {
          "type": "boolean"
        },
        "resolution": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
