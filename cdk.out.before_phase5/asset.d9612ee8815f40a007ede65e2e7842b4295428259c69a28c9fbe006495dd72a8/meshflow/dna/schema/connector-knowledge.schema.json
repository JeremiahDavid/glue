{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshflow.dev/schemas/dna/connector-knowledge.json",
  "title": "Connector Knowledge",
  "description": "Connector-standard entity hints, profiling rules, and silver key derivation config.",
  "type": "object",
  "properties": {
    "source": { "type": "string" },
    "description": { "type": "string" },
    "generated_at": { "type": "string" },
    "entity_count": { "type": "integer", "minimum": 0 },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "column_hints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/column_hint" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "key_derivation": {
      "type": "object",
      "required": ["method", "columns"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["hash", "concat"]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "separator": {
          "type": "string",
          "default": "|"
        },
        "output_column": {
          "type": "string",
          "default": "_row_key",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["silver_entity"],
      "properties": {
        "silver_entity": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["fact", "dimension", "bridge", "reference"]
        },
        "grain": { "type": "string" },
        "primary_key": { "type": "string" },
        "natural_key_columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "key_derivation": { "$ref": "#/$defs/key_derivation" },
        "description": { "type": "string" },
        "foreign_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/foreign_key" }
        }
      },
      "additionalProperties": true
    },
    "foreign_key": {
      "type": "object",
      "required": ["column", "to_entity"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "to_entity": { "type": "string", "minLength": 1 },
        "to_column": { "type": "string" },
        "citation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["from_entity", "from_column", "to_entity", "to_column"],
      "properties": {
        "id": { "type": "string" },
        "from_entity": { "type": "string", "minLength": 1 },
        "from_column": { "type": "string", "minLength": 1 },
        "to_entity": { "type": "string", "minLength": 1 },
        "to_column": { "type": "string", "minLength": 1 },
        "cardinality": { "type": "string" },
        "citation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "column_hint": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "concepts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fk_target_entity": { "type": "string" },
        "fk_target_column": { "type": "string" },
        "citation": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
