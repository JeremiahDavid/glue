{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshflow.dev/schemas/dna/field-semantics.json",
  "title": "Field Semantics",
  "description": "Silver column to operational concept mappings for a tenant.",
  "type": "object",
  "required": ["version", "status", "source", "mappings"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "production"]
    },
    "source": {
      "type": "string",
      "description": "Silver source connector (e.g. dbc, qbo)"
    },
    "updated_at": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "custom_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "category"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["silver_entity", "column", "concepts"],
        "properties": {
          "silver_entity": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "type": "string",
            "minLength": 1
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
